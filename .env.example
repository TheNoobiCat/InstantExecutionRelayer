# BrokerFi Instant Execution Relayer -- testnet configuration example.
# Copy this file to .env and replace every placeholder. Never commit .env.
# This service is unaudited and testnet-only.

# --- Chain access ---
# Testnet JSON-RPC endpoint (HTTP or WebSocket, as supported by the provider).
RPC_URL=https://your-testnet-rpc.example/v1/YOUR_RPC_KEY

# InstantExecutionChannelFactory contract on the testnet.
FACTORY_ADDRESS=0xYOUR_FACTORY_ADDRESS

# --- Relayer / keeper hot wallet ---
# Either RELAYER_PRIVATE_KEY or RELAYER_MNEMONIC is required for transaction
# submission and for the keeper. RELAYER_MNEMONIC takes precedence if both are
# set. The mnemonic derivation in this codebase is simplified and not
# BIP39/BIP44-compatible; a private key is safer for a test deployment.
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY
RELAYER_MNEMONIC=

# --- Tokens ---
# Testnet USDC address used by the faucet and leaderboard profit calculation.
USDC_ADDRESS=0xYOUR_TESTNET_USDC_ADDRESS

# Funded testnet wallet used only by the faucet (omit to disable claims).
FAUCET_PRIVATE_KEY=0xYOUR_FAUCET_PRIVATE_KEY

# --- Captcha ---
# Cloudflare Turnstile secret key, used by the faucet, channel creation, and
# the Grok endpoint.
CAPTCHA_SECRET=YOUR_TURNSTILE_SECRET

# --- Grok / xAI ---
XAI_API_KEY=YOUR_XAI_API_KEY

# --- Optional file paths ---
# Keeper config. Copy keeper_config.example.json and replace its addresses.
CONFIG_PATH=keeper_config.json
GROK_CONFIG_PATH=grok_config.json
LEADERBOARD_DB_PATH=leaderboard.db

# Log level: trace, debug, info, warn, error, fatal, panic.
LOG_LEVEL=info
